# Copie este arquivo para valheim.env e ajuste os valores locais.
SERVER_NAME=PowerGuido_New
WORLD_NAME=PowerGuido
SERVER_PASS=troque-por-uma-senha-forte
SERVER_PUBLIC=true
SERVER_PORT=2456
TZ=America/Sao_Paulo
SEED=EVpmm24uK8

# Backups automáticos: minuto 5 de cada hora, mantendo 7 dias.
BACKUPS=true
BACKUPS_CRON=5 * * * *
BACKUPS_MAX_AGE=7

# Crossplay usa relay e normalmente dispensa port forwarding.
CROSSPLAY=true

# Status HTTP somente na rede interna do Compose; usado pelo painel web.
STATUS_HTTP=true
STATUS_HTTP_PORT=80

# Atualizador periódico; vazio desativa a agenda automática.
UPDATE_CRON=

# Filtros opcionais para mensagens não fatais do runtime atual.
VALHEIM_LOG_FILTER_CONTAINS_EXTERNAL_IP=Could not extract valid IP address from externalIP download string.
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_HTTP=Exception while waiting for respons from https://ipv6
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_HTTP2=Exception while waiting for respons from https://api6.ipify.org
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_HTTP3=Exception while waiting for respons from https://ipv6.myip.wtf
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_STACK=System.Net.Http.HttpClient.CheckDisposedOrStarted
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_TIMEOUT=System.Net.Http.HttpClient.set_Timeout
VALHEIM_LOG_FILTER_CONTAINS_PUBLIC_IP_GETIP=at ZNet.<GetPublicIP>g__DownloadStringAsync
