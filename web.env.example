# Configuração do painel Valheim Web. Copie para web.env; este arquivo não deve
# ser versionado porque contém credenciais e a chave de sessão.
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres
WEB_SECRET_KEY=gere-uma-chave-aleatoria-longa
WEB_HOSTNAME=localhost

# HTTPS autoassinado é gerado no primeiro start e persistido em web-certs/.
WEB_TLS_AUTO_GENERATE=true
WEB_TLS_DAYS=825
# Para certificado próprio, defina também WEB_TLS_CERT_FILE e WEB_TLS_KEY_FILE.
# WEB_TLS_CERT_FILE=/certs/server.crt
# WEB_TLS_KEY_FILE=/certs/server.key
